{
  "name": "luminoir",
  "version": "1.1.17",
  "description": "Browser-based 3D sheet-music visualisation built on Three.js, Verovio and Web Audio.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "dev:lan": "VITE_HTTPS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "bench": "node bench/bench.mjs",
    "bench:camera": "node bench/camera-offline.mjs",
    "bench:camera:all": "node bench/camera-offline.mjs --all",
    "bench:export-timeline": "node bench/export-timeline.mjs",
    "bench:export-page": "node bench/export-from-page.mjs"
  },
  "dependencies": {
    "smplr": "^0.19.0",
    "three": "^0.172.0",
    "verovio": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1",
    "playwright": "^1.48.2",
    "linkedom": "^0.18.5",
    "pngjs": "^7.0.0"
  }
}
